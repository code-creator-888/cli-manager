{
  "name": "cli-manager",
  "version": "1.0.0",
  "description": "CLI Manager - Claude CLI & Copilot CLI Desktop Management Tool",
  "main": "dist-electron/main.js",
  "bin": {
    "cli-manager-start": "bin/cli-manager-start.cjs"
  },
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.cjs",
    "postinstall": "npm run ensure:electron && electron-rebuild -f -w better-sqlite3,node-pty",
    "start:background": "node bin/cli-manager-start.cjs",
    "dev": "npm run ensure:electron && npm run build:electron && concurrently \"vite\" \"electron .\"",
    "dev:vite": "vite",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "rebuild": "npm run ensure:electron && electron-rebuild -f -w better-sqlite3,node-pty",
    "preview": "npm run ensure:electron && vite preview",
    "package": "npm run ensure:electron && npm run build && electron-builder",
    "package:mac": "npm run ensure:electron && npm run build && electron-builder --mac",
    "package:win": "npm run ensure:electron && npm run build && electron-builder --win",
    "package:linux": "npm run ensure:electron && npm run build && electron-builder --linux",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-is-dev": "^3.0.1",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
